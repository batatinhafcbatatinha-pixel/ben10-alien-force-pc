@@ -653,6 +658,11 @@
 )
 
 target_link_libraries(ps2_runtime PUBLIC ps2_host_backend ffmpeg ps2_iop)
+# The runtime and generated code use SSE4.1 intrinsics (_mm_extract_epi32/64, blends). MSVC accepts them
+# unconditionally; GCC/Clang need the target feature enabled for every consumer of the headers.
+if(NOT MSVC AND NOT PS2X_IS_ARM_TARGET AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64|amd64|i.86")
+    target_compile_options(ps2_runtime PUBLIC -msse4.1)
+endif()
 if(WIN32)
     # Native GS renderer (gs/gpu): its own WGL context on the GS thread.
     target_link_libraries(ps2_runtime PRIVATE opengl32 gdi32)
diff -ruN -x .git a/PS2Recomp/ps2xRuntime/src/lib/ps2_runtime.cpp b/PS2Recomp/ps2xRuntime/src/lib/ps2_runtime.cpp
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -1,3 +1,6 @@
+#if defined(__linux__) && !defined(__ANDROID__)
+#include <pthread.h>
+#endif
 #include "ps2_runtime.h"
 #include "host_video_settings.h"
 #include "runtime/gs/gs_gpu_backend.h"
@@ -2965,6 +2968,24 @@
 
     std::atomic<bool> gameThreadFinished{false};
 
+#if defined(__linux__) && !defined(__ANDROID__)
+    // Windows builds link the runner with a large /STACK (unoptimized generated code uses big native frames and
+    // deep guest call chains). glibc sizes std::thread stacks from RLIMIT_STACK (usually 8 MiB), so raise the
+    // process default before the game thread starts. PS2X_THREAD_STACK_MB overrides it (default 64).
+    {
+        size_t stackMb = 64u;
+        if (const char *env = std::getenv("PS2X_THREAD_STACK_MB"))
+            stackMb = std::max<size_t>(8u, static_cast<size_t>(std::strtoul(env, nullptr, 10)));
+        pthread_attr_t attr;
+        if (pthread_attr_init(&attr) == 0)
+        {
+            pthread_attr_setstacksize(&attr, stackMb * 1024u * 1024u);
+            pthread_setattr_default_np(&attr);
+            pthread_attr_destroy(&attr);
+        }
+    }
+#endif
+
     std::thread gameThread([&]()
                            {
         ThreadNaming::SetCurrentThreadName("GameThread");
